<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_haccp_formation_certificat_list" model="ir.ui.view">
    <field name="name">haccp.formation.certificat.list</field>
    <field name="model">haccp.formation.certificat</field>
    <field name="arch" type="xml">
      <list>
        <field name="employe_id"/>
        <field name="type_formation"/>
        <field name="date_formation"/>
      </list>
    </field>
  </record>

  <record id="view_haccp_formation_certificat_form" model="ir.ui.view">
    <field name="name">haccp.formation.certificat.form</field>
    <field name="model">haccp.formation.certificat</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="employe_id"/>
            <field name="type_formation"/>
            <field name="date_formation"/>
            <field name="document_id"/>
            <field name="commentaire"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_haccp_formation_certificat" model="ir.actions.act_window">
    <field name="name">Formations individuelles</field>
    <field name="res_model">haccp.formation.certificat</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
